# secrets — never commit key material
.env
.env.*
# ...but `.env.example` is DOCUMENTATION, not a secret, and directive 3 requires
# it to be committed as the record of every variable name the stack reads. The
# `.env.*` line above silently swallowed it (`git check-ignore -v .env.example`
# -> `.gitignore:3:.env.*`), so `git add deploy/.env.example` refused and the
# only failure signal was the file quietly never appearing in `git status`.
# The negation is scoped to exactly that one filename: `.env`, `.env.local`,
# `.env.production` and every other `.env.*` stay ignored.
!.env.example
*.key
credentials*.json
secrets/

# python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# node
node_modules/
dist/
.next/
*.tsbuildinfo

# os / editor
.DS_Store
.idea/
.vscode/

# local data
*.rdb
falkordb-data/
*.log
eval/data/*.json

# runtime artifacts (a running bridge writes these)
*.pid
eval/.cache/
eval/runs/

# Kaeva/unblock internal source — kept LOCAL, never published (operator ruling 2026-08-03)
vendor/

# cloudflare local build state
.wrangler/

# firehose capture — large + regenerable via realtime/producer.py --source
demo/*.ndjson

