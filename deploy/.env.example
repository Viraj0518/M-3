# SPDX-License-Identifier: Apache-2.0
#
# PALIMPSEST — example environment.
#
#   cp .env.example .env      (up.sh does this for you if .env is missing)
#
# ############################################################################
# # DIRECTIVE 3 — THIS FILE DOCUMENTS VARIABLE *NAMES*, NOT VALUES.          #
# # Every value below is a placeholder or a non-secret local-dev default.    #
# # NEVER put a real secret, key, token or password in this file. `.env` is  #
# # gitignored; `.env.example` is committed. If you ever need a real         #
# # credential, it goes in `.env` on your machine and nowhere else.          #
# ############################################################################

# ---------------------------------------------------------------------------
# Project / networking
# ---------------------------------------------------------------------------

# Compose container-name prefix. Change it to run two stacks side by side.
PALIMPSEST_PROJECT=palimpsest

# Host interface every published port binds to. 127.0.0.1 keeps the whole stack
# off the network — do NOT change this to 0.0.0.0 unless you understand that it
# exposes an unauthenticated graph database to your LAN.
PALIMPSEST_BIND_ADDRESS=127.0.0.1

# Docker build context for the bridge and ui images. BOTH build from the REPO
# ROOT, not from deploy/: the bridge imports `memory.config` and serves
# `app/web` from `config.REPO_ROOT`, and the ui image copies `app/web`. `..`
# is relative to this directory.
PALIMPSEST_REPO_ROOT=..

# ---------------------------------------------------------------------------
# FalkorDB — the attributed graph (memory of record)
# ---------------------------------------------------------------------------

# Graph image. Pin a digest here for a reproducible judge run if you like.
PALIMPSEST_FALKORDB_IMAGE=falkordb/falkordb:latest

# HOST port for the RESP/graph protocol. 6401 — NOT 6379, NOT 6399.
# memory/config.py:52-59 and memory/SCHEMA.md §5: 6379 is the redis default and
# 6399 was verified held by a stray redis-server on a build box; either one lets
# a client CONNECT FINE over RESP and then fail with "unknown command
# GRAPH.QUERY" — a false green that ate 45 minutes. Check with:
#   lsof -i :6379 -i :6399 -i :6401
PALIMPSEST_FALKORDB_PORT=6401

# Host port for the bundled falkordb-browser UI (container 3000).
PALIMPSEST_BROWSER_PORT=3100

# Compose-network hostname the bridge dials. Leave as the service name.
PALIMPSEST_FALKORDB_HOST=falkordb

# IN-CONTAINER port the bridge dials on the compose network. This is the stock
# image's own port and it is correct that it is 6379: the 6401 rule above is a
# HOST rule (about what else is listening on your laptop), and on an isolated
# compose network `falkordb` resolves to exactly one container. Every
# human-facing surface still uses 127.0.0.1:6401.
PALIMPSEST_FALKORDB_CONTAINER_PORT=6379

# The two graph keys. `palimpsest` is the warm graph (the real memory);
# `palimpsest_cold` is deliberately EMPTY and is the A/B target for the
# ablation beat — identical event, cold vs warm, opposite verdicts.
PALIMPSEST_GRAPH_WARM=palimpsest
PALIMPSEST_GRAPH_COLD=palimpsest_cold

# Embedding width. MUST match the embedder's `dimensions=` AND the HNSW index —
# a mismatch corrupts the vector index SILENTLY (no error, just wrong
# neighbours). 256 is the pinned value across the stack; do not change it
# casually.
PALIMPSEST_EMBED_DIM=256

# Extra redis-server args passed to FalkorDB. Default enables RDB snapshots so
# the named volume actually retains state across a restart.
# If you want auth locally: --save 60 1 --appendonly no --requirepass <your-own>
# (put the real value only in your own .env — never here.)
PALIMPSEST_REDIS_ARGS=--save 60 1 --appendonly no

# ---------------------------------------------------------------------------
# bridge — the agent-facing surface (REST + MCP + OpenAPI on ONE port)
# ---------------------------------------------------------------------------

# HOST port for the bridge. 8931 is LOAD-BEARING, in three places at once:
#   1. memory/config.py:BRIDGE_PORT defaults to it;
#   2. app/web/index.html:581 hard-codes `http://127.0.0.1:8931`;
#   3. the MCP Apps contract derives the widget sandbox domain from a sha256 of
#      the ENDPOINT STRING (plan/research/mcp-widgets-guide.md §2.3), so the
#      gate scripts' domain hash changes if this changes.
# Change it and you must change app/web/index.html and re-derive the hash.
PALIMPSEST_BRIDGE_PORT=8931

# IN-CONTAINER port for the bridge. Kept identical to the host port so the
# published endpoint string and the in-container one never diverge.
PALIMPSEST_BRIDGE_CONTAINER_PORT=8931

# What the browser (not the compose network) uses to reach the bridge.
PALIMPSEST_BRIDGE_PUBLIC_URL=http://127.0.0.1:8931

# RocketRide (motion lane) engine URL. Local, no signup, no credential.
ROCKETRIDE_URL=http://127.0.0.1:5565

# ---------------------------------------------------------------------------
# ui
# ---------------------------------------------------------------------------

# Host port for the static projector host (container 5173). The SAME page is
# also served by the bridge itself at http://127.0.0.1:8931/ui/.
PALIMPSEST_UI_PORT=5173

# ---------------------------------------------------------------------------
# LaserData log spine (Apache Iggy + LaserData plane) — profile: logspine
# Only read when you pass `--profile logspine`. Needs a host kernel >= ~6.11;
# see the kernel matrix in README.md and SPONSOR-BUG-REPORT-DRAFT.md.
# ---------------------------------------------------------------------------

LASER_IGGY_IMAGE=docker.io/laserdatainc/iggy-server:latest
LASER_PLANE_IMAGE=docker.io/laserdatainc/laser-plane:latest

# Host port for the Iggy TCP protocol (container 8090).
LASER_IGGY_PORT=8090

# Host port for the Iggy HTTP API (container 3000).
LASER_IGGY_HTTP_PORT=3000

# Iggy root user.
LASER_IGGY_USERNAME=iggy

# PLACEHOLDER — NOT A SECRET. Local-only broker, bound to 127.0.0.1, lives for
# the length of a demo. Replace with your own value in your own .env if you
# care. Never commit a real credential to this file.
LASER_IGGY_PASSWORD=palimpsest-local-dev

# How anything in-repo reaches the spine. TWO NAMES FOR ONE THING (a real trap,
# memory/config.py:laser_connection): laser-stack's ./scripts/up prints an
# export line for LASER_CONNECTION_STRING and the Python SDK has no
# connect_env(), so you read the variable yourself. Use the EXACT string
# ./scripts/up printed — `iggy:laser@...`, NOT the SDK examples'
# `iggy:iggy@...`; the mismatch fails as what looks like a network error.
# Leave EMPTY when running without `--profile logspine`.
#   LASER_CONNECTION_STRING=iggy:laser@127.0.0.1:8090
LASER_CONNECTION_STRING=

# ---------------------------------------------------------------------------
# up.sh behaviour
# ---------------------------------------------------------------------------

# Seconds up.sh will block waiting for every service to report healthy.
PALIMPSEST_START_TIMEOUT=300
