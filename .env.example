# PALIMPSEST — bring-your-own-key configuration (copy to .env, never commit .env)
ANTHROPIC_API_KEY=            # LLM generation (RocketRide agent, GraphRAG pre-bake)
OPENAI_API_KEY=               # embeddings only (dim must match memory/config.py EMBED_DIM=256)
FALKORDB_HOST=127.0.0.1
FALKORDB_PORT=6401
LASER_CONNECTION=             # exact string printed by laser-stack ./scripts/up (iggy:laser@...)
ROCKETRIDE_URL=http://127.0.0.1:5565
ROCKETRIDE_API_KEY=MYAPIKEY   # self-hosted dev key, not a secret
GUILD_WORKSPACE=              # your Guild.ai workspace id
DISCORD_WEBHOOK_URL=          # demo action target (your own webhook)
GITHUB_REPO=                  # scratch repo for demo issue creation (owner/name)
GITHUB_TOKEN=                 # PAT scoped to the scratch repo only

# ── auth lane (auth/) ───────────────────────────────────────────────────────
# The auth service is OPTIONAL and OFF by default: with AUTH_JWKS_URL unset the
# bridge's verifier is inert and identity resolution is exactly as it is today.
AUTH_BASE_URL=http://127.0.0.1:8932
AUTH_GRAPH_KEY=palimpsest_auth   # its own graph key — never the warm demo graph
AUTH_LABEL_PREFIX=Auth           # every label it writes is prefixed
BETTER_AUTH_SECRET=              # signs sessions + encrypts the JWKS private key
# Set these on the BRIDGE to turn verified identity on:
AUTH_JWKS_URL=                   # http://127.0.0.1:8932/api/auth/jwks
AUTH_ISSUER=                     # http://127.0.0.1:8932/api/auth
AUTH_AUDIENCE=                   # http://127.0.0.1:8931/mcp
