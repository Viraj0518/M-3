# PALIMPSEST — bring-your-own-key configuration (copy to .env, never commit .env)
ANTHROPIC_API_KEY=            # LLM generation (RocketRide agent, GraphRAG pre-bake)
OPENAI_API_KEY=               # embeddings only (dim must match memory/config.py EMBED_DIM=256)
FALKORDB_HOST=127.0.0.1
FALKORDB_PORT=6401
LASER_CONNECTION_STRING=      # exact string printed by laser-stack ./scripts/up; Cloud uses token@host
LASER_CONNECTION=             # legacy alias accepted by memory/config.py
LASER_STREAM=live
ROCKETRIDE_URL=http://127.0.0.1:5565
ROCKETRIDE_API_KEY=MYAPIKEY   # self-hosted dev key, not a secret
GUILD_WORKSPACE=              # your Guild.ai workspace id
DISCORD_WEBHOOK_URL=          # demo action target (your own webhook)
GITHUB_REPO=                  # scratch repo for demo issue creation (owner/name)
GITHUB_TOKEN=                 # PAT scoped to the scratch repo only
